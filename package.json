{
  "name": "tikz-drawer",
  "version": "2.1.17",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && tsx scripts/generate-static-route-shells.mts",
    "watch": "ng build --watch --configuration development",
    "generate:latex-validation": "tsx scripts/generate-tikz-validation-output.mts",
    "generate:site-figures": "tsx scripts/generate-site-figure-assets.mts",
    "validate:i18n": "tsx scripts/validate-i18n.mts",
    "validate:i18n:all": "tsx scripts/validate-i18n.mts --all",
    "capture:release": "tsx scripts/release-screenshots.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "bun run lint:eslint && bun run lint:format",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:eslint:fix": "eslint . --fix",
    "lint-fix": "bun run lint:eslint:fix && prettier --write \"**/*.{ts,html,css,scss,json,md}\"",
    "format": "prettier --write \"**/*.{ts,html,css,scss,json,md}\"",
    "lint-format": "bun run lint-fix",
    "lint:format": "prettier --check \"**/*.{ts,html,css,scss,json,md}\"",
    "optimize:png": "tsx scripts/optimize-png.mts",
    "sonar:scan": "sonar-scanner"
  },
  "private": true,
  "packageManager": "bun@1.4.0",
  "trustedDependencies": [
    "@firebase/util",
    "@parcel/watcher",
    "esbuild",
    "lmdb",
    "msgpackr-extract",
    "protobufjs",
    "sharp",
    "sonar-scanner"
  ],
  "dependencies": {
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@angular/service-worker": "^22.1.4",
    "@mlc-ai/web-llm": "^0.2.84",
    "@shoelace-style/shoelace": "^2.20.1",
    "firebase": "^12.18.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@colbymchenry/codegraph": "^1.6.0",
    "@eslint/js": "^9.39.5",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.39.5",
    "fallow": "^2.104.0",
    "jsdom": "^28.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "sonar-scanner": "^3.1.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
